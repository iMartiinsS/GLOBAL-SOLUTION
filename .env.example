# Copie para .env e troque os valores:  cp .env.example .env
# O arquivo .env NÃO é versionado.
POSTGRES_DB=alagalerta
POSTGRES_USER=alagalerta
POSTGRES_PASSWORD=troque-esta-senha
# mínimo de 32 caracteres. Gere com:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
SEED_ENABLED=true
