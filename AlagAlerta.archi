  <folder name="Application" id="id-2d2066282a8fc31f8613391bd36e6446" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Firmware da Estação (Arduino)" id="id-0318b90efabe5485c3d8cdf1cc9dd291">
      <documentation>Lê sensores, classifica risco, aciona alarme local e envia JSON.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Gateway IoT" id="id-ae34f015e4d7c4b466c03dd553389c1a">
      <documentation>Recebe leituras, autentica com JWT e envia à API com fila store-and-forward.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="API AlagAlerta (Java Spring Boot)" id="id-c682a2a772e3e1db5202bcdd37792b84">
      <documentation>Regras de risco, alertas, ocorrências, JWT, cache, HATEOAS.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="API Cadastro da Rede (.NET 8)" id="id-23c4de5561bf88fff06b548ecfc29fdc">
      <documentation>CRUD de regiões e sensores (EF Core + Oracle).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="App AlagAlerta (Flutter)" id="id-f6c0417d0e9053fa28812daab8148e9e"/>
    <element xsi:type="archimate:ApplicationComponent" name="Módulo PL/SQL de priorização" id="id-8cf7012b7f73fb3cacdc1ed096060a92">
      <documentation>Procedures PRC_REGISTRAR_LEITURA e PRC_PRIORIZAR_REGIOES.</documentation>
    </element>
