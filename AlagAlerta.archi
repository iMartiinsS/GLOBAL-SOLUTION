<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="AlagAlerta - Arquitetura de Solução" id="id-20f35e630daf44dbfa4c3f68f5399d8c" version="5.0.0">
  <folder name="Strategy" id="id-8ea634dbcef1a6a7a6bcc646ea146c18" type="strategy"/>
  <folder name="Motivation" id="id-6c9fb8759acb9ff8bf2ba60750bd8246" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Moradores de áreas de risco de enchente" id="id-f84a10e1feeb4416f5f0284285f4edad">
      <documentation>Famílias em bairros às margens de córregos (ex.: Jardim Pantanal, Jardim Romano, Jardim Helena).</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Defesa Civil" id="id-a211b703ff562b9a96dc2baf2eecac0a">
      <documentation>Órgão que monitora riscos, emite alertas e coordena o atendimento.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Prefeitura / Subprefeituras" id="id-3b988606b0de56599bd8aa747755d10f">
      <documentation>Responsável por zeladoria, drenagem e políticas habitacionais.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Enchentes recorrentes em áreas de várzea" id="id-886b942bfafe4a408d3425007ba0faa6">
      <documentation>IBGE/Cemaden: 8,27 milhões de pessoas viviam em áreas de risco de inundação, enxurrada e deslizamento em 872 municípios monitorados (Censo 2010).</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Mudança climática: chuvas mais intensas" id="id-b4c88fb6293709096995c5d94ba267cb">
      <documentation>Eventos extremos de chuva mais frequentes (ODS 13).</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Morador só percebe quando a água entra em casa" id="id-4335c6f48fae9bdc769defa39993dd8a">
      <documentation>Não há medição local do nível dos córregos acessível ao cidadão.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Alertas oficiais são genéricos por região" id="id-597a1e6954615377f305eb6e4e99e05d">
      <documentation>O aviso não indica qual córrego está subindo agora.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Energia e internet caem durante temporais" id="id-4dcfe59a734bc05877cf25946cfef291">
      <documentation>A solução precisa continuar útil fora do cenário ideal de conectividade.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Antecipar o aviso de enchente ao morador" id="id-adc0ddb8798ee4160dfd0362043e4363"/>
    <element xsi:type="archimate:Goal" name="Reduzir perdas humanas e materiais" id="id-9e6be163689ef4d5e02023afd88aaecc">
      <documentation>ODS 11.5: reduzir mortes e pessoas afetadas por desastres.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Priorizar o atendimento da Defesa Civil" id="id-5a48cc77d21ef1a7eb99b885d8ff6783"/>
    <element xsi:type="archimate:Principle" name="Alarme local funciona sem internet" id="id-33feea3fc82fb82fbebed1a71add8f35">
      <documentation>Edge computing: a estação decide e alerta no ponto.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Proteção de dados pessoais (LGPD)" id="id-1bbc4b7b24db83df32488d9195592008">
      <documentation>Senhas com hash, JWT, mínimo de dados pessoais.</documentation>
    </element>
    <element xsi:type="archimate:Outcome" name="Alerta em até 2 min após o córrego atingir o limite" id="id-e7ea1c5197b61ca724927b653ae12460"/>
    <element xsi:type="archimate:Outcome" name="80% dos moradores da área de risco cadastrados no app" id="id-f1d4ef0b398b0010eb950505c3ac76f1"/>
    <element xsi:type="archimate:Outcome" name="Tempo de resposta da Defesa Civil 30% menor" id="id-c774e030afa7d3a741a9862d423300b4"/>
    <element xsi:type="archimate:Constraint" name="Estação de baixo custo (&lt; R$ 500)" id="id-6d8115f7b94285675f1d01147900913c"/>
    <element xsi:type="archimate:Constraint" name="Conectividade instável no campo" id="id-414f5ab8ec8b31ae3c47f3b8260c3c62"/>
    <element xsi:type="archimate:Requirement" name="Medir nível da água e chuva em tempo real" id="id-89de11194d8d6ec2f0d836a927029f5d"/>
    <element xsi:type="archimate:Requirement" name="Notificar moradores por bairro" id="id-c76e3d5e7f6f28482e8b2e4cfd2dda1a"/>
    <element xsi:type="archimate:Requirement" name="Receber relatos de alagamento do cidadão" id="id-f606c26bdaff4c7bd02feb195c48614c"/>
    <element xsi:type="archimate:Requirement" name="Ranking de prioridade por região" id="id-fa24d77289c0dd517cea44e8d2d0a4db"/>
    <element xsi:type="archimate:Requirement" name="Alarme sonoro/visual no local" id="id-53c45e966838dbad6a0ad1e211c7cdb2"/>
  </folder>
