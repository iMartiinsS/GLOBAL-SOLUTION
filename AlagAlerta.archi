    <element xsi:type="archimate:BusinessProcess" name="Monitorar córregos" id="id-604c63c3020021c975c2cf49d5f2deb9"/>
    <element xsi:type="archimate:BusinessProcess" name="Classificar risco" id="id-67a0dbf628aa80f42d3a848fde09b503">
      <documentation>NORMAL, ATENÇÃO, ALERTA, EMERGÊNCIA conforme limites de cada córrego.</documentation>
    </element>
